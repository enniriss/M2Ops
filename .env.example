# Copier en .env (ignoré par git) et remplir. docker compose le lit tout seul.

# Base Postgres de l'historique Dagster (valeurs par défaut si absent).
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=dagster
DAGSTER_PG_DB=dagster

# Canal d'alerte de l'équipe : URL d'un webhook Discord (Paramètres du salon > Intégrations >
# Webhooks) ou Slack (Incoming Webhooks). Vide : les alertes ne sont que dans les journaux Dagster.
GAZETTE_ALERTE_WEBHOOK=
